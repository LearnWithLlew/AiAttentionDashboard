<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aiattentiondashboard</AssemblyName>
    <RootNamespace>AIAttentionDashboard</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aiattentiondashboard</ToolCommandName>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SkillPage.md" LogicalName="SkillPage.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIAttentionDashboard.Tests" />
  </ItemGroup>

</Project>
