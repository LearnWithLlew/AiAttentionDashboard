<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aiattentiondashboard</AssemblyName>
    <RootNamespace>AIAttentionDashboard</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aiattentiondashboard</ToolCommandName>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
    <PackageId>AIAttentionDashboard</PackageId>
    <Version>0.1.0</Version>
    <Authors>Llewellyn Falco, Jay Bazuzi</Authors>
    <Description>A CLI for AI coding agents that shows high-level action items for the user in a small browser window.</Description>
    <PackageTags>ai;claude;dashboard;cli;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LearnWithLlew/AiAttentionDashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LearnWithLlew/AiAttentionDashboard.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SkillPage.md" LogicalName="SkillPage.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIAttentionDashboard.Tests" />
  </ItemGroup>

</Project>
